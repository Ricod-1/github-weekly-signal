# ============================================================
# 开源信号 · 环境变量配置示例
# 复制此文件为 .env 并填写实际值
# ============================================================

# ---------- 服务配置 ----------
PORT=3000
NODE_ENV=development

# ---------- 定时任务配置 ----------
# Cron 表达式，默认每周日 18:00
CRON_EXPRESSION=0 18 * * 0
TIMEZONE=Asia/Shanghai

# ---------- DeepSeek AI 配置 ----------
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_TEMPERATURE=0.35
DEEPSEEK_MAX_README_LENGTH=24000

# ---------- 管理接口配置 ----------
ADMIN_TOKEN=

# ---------- 存储配置 ----------
REPORTS_DIR=data/reports

# ---------- 周报配置 ----------
REPORT_MAX_PROJECTS=10
TRENDING_SINCE=weekly
